# Backend example environment variables
# For Docker Compose, DB_HOST should be `db` (service name).
# For local development, set DB_HOST=localhost and ensure Postgres is running.
PORT=5000
DB_HOST=db
DB_PORT=5432
DB_NAME=hiretrack
DB_USER=postgres
DB_PASSWORD=yourpassword
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password
# Server
PORT=5000
NODE_ENV=development

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiretrack
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT - change these to long random strings in production
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (for follow-up reminders) - use Gmail App Password
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
